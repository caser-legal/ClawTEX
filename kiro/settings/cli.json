{
  "ai.terminal-hash-sub": false,
  "app.disableAutoupdates": true,
  "app.hideMenubarIcon": false,
  "app.launchOnStartup": false,
  "autoInitLsp": true,
  "autocomplete.developerMode": false,
  "autocomplete.disable": false,
  "autocomplete.insertSpaceAutomatically": false,
  "autocomplete.keybindings.control+k": "ignore",
  "autocomplete.keybindings.control+n": "ignore",
  "autocomplete.keybindings.control+p": "ignore",
  "autocomplete.keybindings.control+r": "ignore",
  "autocomplete.keybindings.down": "ignore",
  "autocomplete.keybindings.enter": "ignore",
  "autocomplete.keybindings.shift+tab": "ignore",
  "autocomplete.keybindings.tab": "ignore",
  "autocomplete.keybindings.up": "ignore",
  "chat.enableCheckpoint": false,
  "chat.enableContextUsageIndicator": true,
  "chat.enableKnowledge": true,
  "chat.enableThinking": true,
  "chat.enableTodoList": false,
  "chat.greeting.enabled": false,
  "codeWhisperer.shareCodeWhispererContentWithAWS": false,
  "defaultAgent": "ios-supercoder",
  "defaultModel": "claude-sonnet-4.5",
  "enableCodeIntelligence": true,
  "inline.enabled": false,
  "integrations.hyper.disabled": true,
  "integrations.iterm.disabled": true,
  "integrations.vscode.disabled": true,
  "telemetry.enabled": false
}