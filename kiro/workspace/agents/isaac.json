      {
        "command": "cat ~/.kiro/workspace/memory/anchor.md"
      },
      {
        "command": "cat ~/.kiro/workspace/memory/semantic.json"
      },
      {
        "command": "cat ~/.kiro/workspace/memory/procedural.md"
      }
    ]
  },
  "model": "deepseek-3.2"
}
